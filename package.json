{
  "name": "user-agent-model-sync",
  "displayName": "Agent Model Sync",
  "description": "Keep your user-defined VS Code agents on the same model as the Explore agent.",
  "publisher": "BelugaRex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BelugaRex/agent-model-sync.git"
  },
  "bugs": {
    "url": "https://github.com/BelugaRex/agent-model-sync/issues"
  },
  "homepage": "https://github.com/BelugaRex/agent-model-sync#readme",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "copilot",
    "agents",
    "model",
    "sync"
  ],
  "files": [
    "extension.cjs",
    "sync-core.cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "userAgentModelSync.sync",
        "title": "Agent Model Sync: 立即同步 Explore 模型"
      },
      {
        "command": "userAgentModelSync.status",
        "title": "Agent Model Sync: 查看模型同步状态"
      }
    ],
    "configuration": {
      "title": "Agent Model Sync",
      "properties": {
        "userAgentModelSync.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "自动将 Explore 的模型同步到所有用户级 VS Code 智能体；包含新建文件，不修改工作区智能体。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "test:package": "python3 -I -B test/package.test.py",
    "test:host": "node test/host/run-vsix.cjs",
    "package": "python3 build_vsix.py",
    "package:list": "vsce ls --no-dependencies",
    "package:marketplace": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && vsce package --no-dependencies --out dist/user-agent-model-sync-0.1.0-marketplace.vsix",
    "verify:package": "python3 -I -B scripts/verify-package.py"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1"
  }
}
