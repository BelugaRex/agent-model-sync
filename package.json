{
  "name": "user-agent-model-sync",
  "displayName": "Agent Model Sync",
  "description": "Keep your user-defined VS Code agents on the same model as the Explore agent.",
  "publisher": "belugarex-local",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "userAgentModelSync.sync", "title": "Agent Model Sync: 立即同步 Explore 模型" },
      { "command": "userAgentModelSync.status", "title": "Agent Model Sync: 查看模型同步状态" }
    ],
    "configuration": {
      "title": "Agent Model Sync",
      "properties": {
        "userAgentModelSync.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "自动将 Explore 的模型同步到所有用户级 VS Code 智能体；包含新建文件，不修改工作区智能体。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "package": "python3 build_vsix.py"
  }
}
